{
  "manifest_version": 3,
  "name": "CyberPet - Office Browser Companion",
  "version": "1.5.0",
  "version_name": "1.0.0",
  "description": "A pixel-art cyber pet living in your browser corner. Feed, bathe, and pet your cat, shiba, rabbit, or groundhog. Built-in Pomodoro focus timer with slack-off detection.",
  "homepage_url": "https://github.com/boweryoung-alt/CyberPet",
  "author": "yangbowen24",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
